# The variables of deploy/compose.yaml. new-env.ps1 makes .env with random values; this file shows the names only.
MYSQL_ROOT_PASSWORD=<random>
OPSFLOW_DB_PASSWORD=<random>
OPSFLOW_MIGRATION_PASSWORD=<random>
OPSFLOW_RABBITMQ_PASSWORD=<random>
OPSFLOW_TOKEN_SIGNING_KEY=<Base64 of 32 random bytes>
# Optional: the port of the pages on this machine, 8000 by default.
# OPSFLOW_WEB_PORT=8000
